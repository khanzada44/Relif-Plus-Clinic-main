# Social links shown in the footer. Leave any of these unset to hide that
# platform's icon entirely — never fall back to a placeholder URL.
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TIKTOK_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_YOUTUBE_URL=

# Required for the /contact and /book-appointment forms to actually deliver
# submissions by email (see the Forms Audit — currently unset, so the API
# route responds with an honest error instead of a false success).
RESEND_API_KEY=

# Search engine / webmaster-tools site verification codes. Get these from
# Google Search Console / Bing Webmaster Tools once you add the property —
# leave unset until then rather than guessing a code.
BING_SITE_VERIFICATION=
GOOGLE_SITE_VERIFICATION=zqevJvKQDceb8jcURcmphY-aZ9bUdd5cQYREqaTpwNc